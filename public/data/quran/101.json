{"number": 101, "nameArabic": "سُورَةُ القَارِعَةِ", "nameEnglish": "Al-Qaari'a", "revelationType": "Meccan", "numberOfAyahs": 11, "bismillahPre": true, "ayahs": [{"number": 6158, "numberInSurah": 1, "juz": 30, "page": 600, "textArabic": "ٱلْقَارِعَةُ", "textSomali": "Qaaricada (qalbiga garaacda)."}, {"number": 6159, "numberInSurah": 2, "juz": 30, "page": 600, "textArabic": "مَا ٱلْقَارِعَةُ", "textSomali": "Qaarica maxay tahay."}, {"number": 6160, "numberInSurah": 3, "juz": 30, "page": 600, "textArabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "textSomali": "Mase taqaannaa Qaarico."}, {"number": 6161, "numberInSurah": 4, "juz": 30, "page": 600, "textArabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "textSomali": "Waa Maalinta Dadku noqon sida Baalallay."}, {"number": 6162, "numberInSurah": 5, "juz": 30, "page": 600, "textArabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "textSomali": "Buuruhuna ay noqon sida Suuf kala firdhay."}, {"number": 6163, "numberInSurah": 6, "juz": 30, "page": 600, "textArabic": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "textSomali": "Ruuxiise miisaankiisa (fiican) cuslaado."}, {"number": 6164, "numberInSurah": 7, "juz": 30, "page": 600, "textArabic": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "textSomali": "Wuxuu ku noolaan nolol raalli ah."}, {"number": 6165, "numberInSurah": 8, "juz": 30, "page": 600, "textArabic": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "textSomali": "Ruuxiise uu fududaado Miisaankiisa (fiican)."}, {"number": 6166, "numberInSurah": 9, "juz": 30, "page": 600, "textArabic": "فَأُمُّهُۥ هَاوِيَةٌۭ", "textSomali": "Wuxuu u hoydaa (Naarta) Haawiya."}, {"number": 6167, "numberInSurah": 10, "juz": 30, "page": 600, "textArabic": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "textSomali": "Ma taqaannaa Haawiya."}, {"number": 6168, "numberInSurah": 11, "juz": 30, "page": 600, "textArabic": "نَارٌ حَامِيَةٌۢ", "textSomali": "Waa Naar kulayl daran."}]}