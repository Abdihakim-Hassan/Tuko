{"number": 113, "nameArabic": "سُورَةُ الفَلَقِ", "nameEnglish": "Al-Falaq", "revelationType": "Meccan", "numberOfAyahs": 5, "bismillahPre": true, "ayahs": [{"number": 6226, "numberInSurah": 1, "juz": 30, "page": 604, "textArabic": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "textSomali": "Waxaad dhahdaa (Nabiyow) waxaan ka magangalay Eebeha Subaxa (abuuray)."}, {"number": 6227, "numberInSurah": 2, "juz": 30, "page": 604, "textArabic": "مِن شَرِّ مَا خَلَقَ", "textSomali": "Wixii shar leh sharkiisa."}, {"number": 6228, "numberInSurah": 3, "juz": 30, "page": 604, "textArabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "textSomali": "Iyo Habeenka sharkiisa markuu madoobaado."}, {"number": 6229, "numberInSurah": 4, "juz": 30, "page": 604, "textArabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "textSomali": "Iyo sharka Sixirrowga wax ku tufa guntimaha."}, {"number": 6230, "numberInSurah": 5, "juz": 30, "page": 604, "textArabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "textSomali": "Iyo sharka Xaasidka wax Xasda."}]}