{"number": 106, "nameArabic": "سُورَةُ قُرَيۡشٍ", "nameEnglish": "Quraish", "revelationType": "Meccan", "numberOfAyahs": 4, "bismillahPre": true, "ayahs": [{"number": 6194, "numberInSurah": 1, "juz": 30, "page": 602, "textArabic": "لِإِيلَٰفِ قُرَيْشٍ", "textSomali": "Caadaysigii Qureesheed."}, {"number": 6195, "numberInSurah": 2, "juz": 30, "page": 602, "textArabic": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ", "textSomali": "Ay ka caadayeesheen Safarka Xagaaga iyo Jilaalka darteed."}, {"number": 6196, "numberInSurah": 3, "juz": 30, "page": 602, "textArabic": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ", "textSomali": "Ha u caabudeen Eebeha Beydkan (Kacbada)."}, {"number": 6197, "numberInSurah": 4, "juz": 30, "page": 602, "textArabic": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ", "textSomali": "Eebahi ka quudiyay gaajo, kana aamingaliyay cabsi."}]}