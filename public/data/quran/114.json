{"number": 114, "nameArabic": "سُورَةُ النَّاسِ", "nameEnglish": "An-Naas", "revelationType": "Meccan", "numberOfAyahs": 6, "bismillahPre": true, "ayahs": [{"number": 6231, "numberInSurah": 1, "juz": 30, "page": 604, "textArabic": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "textSomali": "Waxaad dhahdaa «Nabiyow» waxaan ka magangeley Eebaha dadka barbaariya."}, {"number": 6232, "numberInSurah": 2, "juz": 30, "page": 604, "textArabic": "مَلِكِ ٱلنَّاسِ", "textSomali": "Ee dadka xukuma."}, {"number": 6233, "numberInSurah": 3, "juz": 30, "page": 604, "textArabic": "إِلَٰهِ ٱلنَّاسِ", "textSomali": "Ee ah Ilaaha dadka."}, {"number": 6234, "numberInSurah": 4, "juz": 30, "page": 604, "textArabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "textSomali": "Sharka «iyo xumaanta» waswaasiyaha qarsoon."}, {"number": 6235, "numberInSurah": 5, "juz": 30, "page": 604, "textArabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "textSomali": "Ee waswaasiya laabta «Qalbiga» dadka."}, {"number": 6236, "numberInSurah": 6, "juz": 30, "page": 604, "textArabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "textSomali": "«Kuwaas wax waswaasinayna» oo ah jinni iyo insiba."}]}