{"number": 105, "nameArabic": "سُورَةُ الفِيلِ", "nameEnglish": "Al-Fil", "revelationType": "Meccan", "numberOfAyahs": 5, "bismillahPre": true, "ayahs": [{"number": 6189, "numberInSurah": 1, "juz": 30, "page": 601, "textArabic": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ", "textSomali": "Ma Ogtahay sida Eeba ku falay asaxaabtii Maroodiga «Colkii»."}, {"number": 6190, "numberInSurah": 2, "juz": 30, "page": 601, "textArabic": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ", "textSomali": "Miyaan Eebe ka yeelin dhagartoodii wax dhumay."}, {"number": 6191, "numberInSurah": 3, "juz": 30, "page": 601, "textArabic": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ", "textSomali": "Oosan ku dirin korkooda Shimbiro kooxa ah."}, {"number": 6192, "numberInSurah": 4, "juz": 30, "page": 601, "textArabic": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ", "textSomali": "Kuna tuuraysa Dhagaxyo la kululeeyay."}, {"number": 6193, "numberInSurah": 5, "juz": 30, "page": 601, "textArabic": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ", "textSomali": "Markaas Eebe ka yeelay Bal la daaqay sidiis."}]}