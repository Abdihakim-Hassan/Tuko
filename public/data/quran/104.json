{"number": 104, "nameArabic": "سُورَةُ الهُمَزَةِ", "nameEnglish": "Al-Humaza", "revelationType": "Meccan", "numberOfAyahs": 9, "bismillahPre": true, "ayahs": [{"number": 6180, "numberInSurah": 1, "juz": 30, "page": 601, "textArabic": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "textSomali": "Halaag Wuxuu u Sugnaaday xanle wax ceebeya oo Dhan,"}, {"number": 6181, "numberInSurah": 2, "juz": 30, "page": 601, "textArabic": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "textSomali": "Oo Xoolaha kulmiya (xaqana ku bixinin)."}, {"number": 6182, "numberInSurah": 3, "juz": 30, "page": 601, "textArabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "textSomali": "Ma wuxuu malayn in xoolihiisu waarin."}, {"number": 6183, "numberInSurah": 4, "juz": 30, "page": 601, "textArabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "textSomali": "Saas ma aha ee waxaa lagu tuuri (Naarta) Xudhama."}, {"number": 6184, "numberInSurah": 5, "juz": 30, "page": 601, "textArabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "textSomali": "Ma taqaannaa Xudhama."}, {"number": 6185, "numberInSurah": 6, "juz": 30, "page": 601, "textArabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "textSomali": "Waa Naarta Eebe ee la huriyay."}, {"number": 6186, "numberInSurah": 7, "juz": 30, "page": 601, "textArabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "textSomali": "Gubaysana Quluubta (Kulayl dartiis)."}, {"number": 6187, "numberInSurah": 8, "juz": 30, "page": 601, "textArabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "textSomali": "Waana lagu dabooli Naartaas Gaalada."}, {"number": 6188, "numberInSurah": 9, "juz": 30, "page": 601, "textArabic": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "textSomali": "Tiraar la fidiyay yayna ahaan dhexdeeda."}]}