{"number": 80, "nameArabic": "سُورَةُ عَبَسَ", "nameEnglish": "Abasa", "revelationType": "Meccan", "numberOfAyahs": 42, "bismillahPre": true, "ayahs": [{"number": 5759, "numberInSurah": 1, "juz": 30, "page": 585, "textArabic": "عَبَسَ وَتَوَلَّىٰٓ", "textSomali": "Wajiguu u uruuriyay oo jeedsaday (Nabigu)."}, {"number": 5760, "numberInSurah": 2, "juz": 30, "page": 585, "textArabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "textSomali": "Inuu u yimid kii Indhaha la'aa."}, {"number": 5761, "numberInSurah": 3, "juz": 30, "page": 585, "textArabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "textSomali": "Miyaad ogtahay inay u dhawdahay inuu hanuuno oo Daahir noqdo."}, {"number": 5762, "numberInSurah": 4, "juz": 30, "page": 585, "textArabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "textSomali": "Ama uu xusuusto oy xusuustu anfacdo."}, {"number": 5763, "numberInSurah": 5, "juz": 30, "page": 585, "textArabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "textSomali": "Ruuxiise is deeqtoonaysiiya (islana waynaada)."}, {"number": 5764, "numberInSurah": 6, "juz": 30, "page": 585, "textArabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "textSomali": "Ma; Adaa u bambixi."}, {"number": 5765, "numberInSurah": 7, "juz": 30, "page": 585, "textArabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "textSomali": "Maxaa kaa saaran hadduusan hanuunin."}, {"number": 5766, "numberInSurah": 8, "juz": 30, "page": 585, "textArabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "textSomali": "Ruuxiise kuu yimaadda isagoo dagdagi."}, {"number": 5767, "numberInSurah": 9, "juz": 30, "page": 585, "textArabic": "وَهُوَ يَخْشَىٰ", "textSomali": "Oo Eeba ka yaabi."}, {"number": 5768, "numberInSurah": 10, "juz": 30, "page": 585, "textArabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "textSomali": "Miyaad ka shuqloomi."}, {"number": 5769, "numberInSurah": 11, "juz": 30, "page": 585, "textArabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "textSomali": "Saas ma; aha ee Aayadahani waa waano."}, {"number": 5770, "numberInSurah": 12, "juz": 30, "page": 585, "textArabic": "فَمَن شَآءَ ذَكَرَهُۥ", "textSomali": "Ruuxii doonana wuu ku waana qaadan."}, {"number": 5771, "numberInSurah": 13, "juz": 30, "page": 585, "textArabic": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "textSomali": "Waxay ku sugantahay (waanadu) Kutub Sharaf leh."}, {"number": 5772, "numberInSurah": 14, "juz": 30, "page": 585, "textArabic": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "textSomali": "Oo la kor yeelay lana Daahiriyay."}, {"number": 5773, "numberInSurah": 15, "juz": 30, "page": 585, "textArabic": "بِأَيْدِى سَفَرَةٍۢ", "textSomali": "Oy Gacanta ku hayaan Malaa'ig (wax qorta)."}, {"number": 5774, "numberInSurah": 16, "juz": 30, "page": 585, "textArabic": "كِرَامٍۭ بَرَرَةٍۢ", "textSomali": "Sharafna leh oo baarri ah."}, {"number": 5775, "numberInSurah": 17, "juz": 30, "page": 585, "textArabic": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "textSomali": "Gaalo halla lacnado Gaalnima badanaa."}, {"number": 5776, "numberInSurah": 18, "juz": 30, "page": 585, "textArabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "textSomali": "Muxuu Eebe ka abuuray kuwaas."}, {"number": 5777, "numberInSurah": 19, "juz": 30, "page": 585, "textArabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "textSomali": "Dhibicbuu ka abuuray wuuna ekeeyay."}, {"number": 5778, "numberInSurah": 20, "juz": 30, "page": 585, "textArabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "textSomali": "Jidkana wuu u fudaydiyay."}, {"number": 5779, "numberInSurah": 21, "juz": 30, "page": 585, "textArabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "textSomali": "Markaasuu dilaa Qabrina ku Asturaa."}, {"number": 5780, "numberInSurah": 22, "juz": 30, "page": 585, "textArabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "textSomali": "Markuu doonana wuu soo bixin."}, {"number": 5781, "numberInSurah": 23, "juz": 30, "page": 585, "textArabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "textSomali": "Saas ma; aha (ee Dadku) wixii la faray ma yeelin."}, {"number": 5782, "numberInSurah": 24, "juz": 30, "page": 585, "textArabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "textSomali": "Dadku ha fiiriyo Cuntadiisa."}, {"number": 5783, "numberInSurah": 25, "juz": 30, "page": 585, "textArabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "textSomali": "Inaan Roob ku soo shubno."}, {"number": 5784, "numberInSurah": 26, "juz": 30, "page": 585, "textArabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "textSomali": "Dhulkana markaas aan jeexno."}, {"number": 5785, "numberInSurah": 27, "juz": 30, "page": 585, "textArabic": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "textSomali": "Kana soo bixinno Midho."}, {"number": 5786, "numberInSurah": 28, "juz": 30, "page": 585, "textArabic": "وَعِنَبًۭا وَقَضْبًۭا", "textSomali": "Iyo cinab iyo Daaqa (Xoolaha)"}, {"number": 5787, "numberInSurah": 29, "juz": 30, "page": 585, "textArabic": "وَزَيْتُونًۭا وَنَخْلًۭا", "textSomali": "Iyo Zeytuun iyo Timir."}, {"number": 5788, "numberInSurah": 30, "juz": 30, "page": 585, "textArabic": "وَحَدَآئِقَ غُلْبًۭا", "textSomali": "Iyo Beerow waawayn."}, {"number": 5789, "numberInSurah": 31, "juz": 30, "page": 585, "textArabic": "وَفَٰكِهَةًۭ وَأَبًّۭا", "textSomali": "Iyo Faakiho (khudaar) iyo Daaq."}, {"number": 5790, "numberInSurah": 32, "juz": 30, "page": 585, "textArabic": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "textSomali": "Si aad ugu intifaacdaan idinka iyo xoolihiinnu."}, {"number": 5791, "numberInSurah": 33, "juz": 30, "page": 585, "textArabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "textSomali": "Markay Qayladii darrayd timaaddo (Suurka)."}, {"number": 5792, "numberInSurah": 34, "juz": 30, "page": 585, "textArabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "textSomali": "Waa maalinta Ruuxu ka carari Walaalkiis."}, {"number": 5793, "numberInSurah": 35, "juz": 30, "page": 585, "textArabic": "وَأُمِّهِۦ وَأَبِيهِ", "textSomali": "Iyo Hooyadiis Iyo Aabihiis."}, {"number": 5794, "numberInSurah": 36, "juz": 30, "page": 585, "textArabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "textSomali": "Iyo Haweeneydiisii iyo Carruurtiisii."}, {"number": 5795, "numberInSurah": 37, "juz": 30, "page": 585, "textArabic": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "textSomali": "Ruux walbana Maalintaas waxaa shuqlin xaalkiisa."}, {"number": 5796, "numberInSurah": 38, "juz": 30, "page": 585, "textArabic": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "textSomali": "Wajiyaal Maalintaas way Nuuri (Farxi)."}, {"number": 5797, "numberInSurah": 39, "juz": 30, "page": 585, "textArabic": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "textSomali": "Wayna Qosli oy bishaaraysan."}, {"number": 5798, "numberInSurah": 40, "juz": 30, "page": 585, "textArabic": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "textSomali": "Wajiyaalna Maalintaas waxaa ka muuqan Dulli."}, {"number": 5799, "numberInSurah": 41, "juz": 30, "page": 585, "textArabic": "تَرْهَقُهَا قَتَرَةٌ", "textSomali": "Waxaana dabooli Madow (iyo naxdin)."}, {"number": 5800, "numberInSurah": 42, "juz": 30, "page": 585, "textArabic": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "textSomali": "Kuwaasina waa Gaalada Faasiqiinta ah (aadna u xun)."}]}