{"number": 94, "nameArabic": "سُورَةُ الشَّرۡحِ", "nameEnglish": "Ash-Sharh", "revelationType": "Meccan", "numberOfAyahs": 8, "bismillahPre": true, "ayahs": [{"number": 6091, "numberInSurah": 1, "juz": 30, "page": 596, "textArabic": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "textSomali": "Miyannaan kuu waasicinin Laabta (ku nuurinin)."}, {"number": 6092, "numberInSurah": 2, "juz": 30, "page": 596, "textArabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "textSomali": "Oonaan ka dajinin culayskii."}, {"number": 6093, "numberInSurah": 3, "juz": 30, "page": 596, "textArabic": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "textSomali": "dhabarka kaa cusleeyay."}, {"number": 6094, "numberInSurah": 4, "juz": 30, "page": 596, "textArabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "textSomali": "Miyaannaan kor yeelin magacaaga (xusiddaada)."}, {"number": 6095, "numberInSurah": 5, "juz": 30, "page": 596, "textArabic": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "textSomali": "Cidhiidhina waxaa ku dhaw fudayd (faraj)."}, {"number": 6096, "numberInSurah": 6, "juz": 30, "page": 596, "textArabic": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "textSomali": "Cidhiidhina waxaa ku dhaw fudayd."}, {"number": 6097, "numberInSurah": 7, "juz": 30, "page": 596, "textArabic": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "textSomali": "Ee markaad Salaadda dhammayso isku dhib (Samo fal)."}, {"number": 6098, "numberInSurah": 8, "juz": 30, "page": 596, "textArabic": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "textSomali": "Eebana (Khayr) ka rajee."}]}