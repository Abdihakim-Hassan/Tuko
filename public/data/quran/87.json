{"number": 87, "nameArabic": "سُورَةُ الأَعۡلَىٰ", "nameEnglish": "Al-A'laa", "revelationType": "Meccan", "numberOfAyahs": 19, "bismillahPre": true, "ayahs": [{"number": 5949, "numberInSurah": 1, "juz": 30, "page": 591, "textArabic": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "textSomali": "Waynee Magaca Eebe ee Sarreeya."}, {"number": 5950, "numberInSurah": 2, "juz": 30, "page": 591, "textArabic": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "textSomali": "Eebaha abuuray khalqiga ekeeyayna."}, {"number": 5951, "numberInSurah": 3, "juz": 30, "page": 591, "textArabic": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "textSomali": "Eebaha wax walba qaddaray Jidkana tusiyey."}, {"number": 5952, "numberInSurah": 4, "juz": 30, "page": 591, "textArabic": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "textSomali": "Eebaha soo bixiya Daaqa."}, {"number": 5953, "numberInSurah": 5, "juz": 30, "page": 591, "textArabic": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "textSomali": "Kana dhiga markaas ka dib caws ingagagan oo Madow."}, {"number": 5954, "numberInSurah": 6, "juz": 30, "page": 591, "textArabic": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "textSomali": "Waxaan kuu akhriyaynaa Quraanka halmaaminamaysid."}, {"number": 5955, "numberInSurah": 7, "juz": 30, "page": 591, "textArabic": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "textSomali": "Wuxuu Eebe doono mooyee, Eebana waa ogyahay waxa muuqda iyo waxa qarsoonba."}, {"number": 5956, "numberInSurah": 8, "juz": 30, "page": 591, "textArabic": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "textSomali": "Waxaana kuu fududaynhaynaa Waddo fiican."}, {"number": 5957, "numberInSurah": 9, "juz": 30, "page": 591, "textArabic": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "textSomali": "Ee wax waani (Nabiyow) markay wax tari waanadu."}, {"number": 5958, "numberInSurah": 10, "juz": 30, "page": 591, "textArabic": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "textSomali": "Waxaa waantoobi Ruuxa Eebe ka yaabee."}, {"number": 5959, "numberInSurah": 11, "juz": 30, "page": 591, "textArabic": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "textSomali": "Waxaana ka fogaan waanada Ruuxa xune."}, {"number": 5960, "numberInSurah": 12, "juz": 30, "page": 591, "textArabic": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "textSomali": "Ee ah mid gali Naar wayn."}, {"number": 5961, "numberInSurah": 13, "juz": 30, "page": 591, "textArabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "textSomali": "Oon kuna dhimanayn dhexdeeda kuna noolanayn."}, {"number": 5962, "numberInSurah": 14, "juz": 30, "page": 591, "textArabic": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "textSomali": "Waxaana liibaanay Ruuxii Daahir noqda."}, {"number": 5963, "numberInSurah": 15, "juz": 30, "page": 591, "textArabic": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "textSomali": "magaca Eebana Xusa, Salaaddana tukada."}, {"number": 5964, "numberInSurah": 16, "juz": 30, "page": 592, "textArabic": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "textSomali": "Saas ma'aha ee Dadku wuxuu doortay nolosha Adduunyo ee dhaw."}, {"number": 5965, "numberInSurah": 17, "juz": 30, "page": 592, "textArabic": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "textSomali": "Aakhiraase khayr badan baaqina ah (hadhi)."}, {"number": 5966, "numberInSurah": 18, "juz": 30, "page": 592, "textArabic": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "textSomali": "Arrintaasuna waxay ku sugantahay Kutubtii hore."}, {"number": 5967, "numberInSurah": 19, "juz": 30, "page": 592, "textArabic": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "textSomali": "Kutubtii (Nabi) Ibraahim iyo (Nabi) Muuse."}]}