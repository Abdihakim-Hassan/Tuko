{"number": 82, "nameArabic": "سُورَةُ الانفِطَارِ", "nameEnglish": "Al-Infitaar", "revelationType": "Meccan", "numberOfAyahs": 19, "bismillahPre": true, "ayahs": [{"number": 5830, "numberInSurah": 1, "juz": 30, "page": 587, "textArabic": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "textSomali": "Markay Samadu Dildillaacdo."}, {"number": 5831, "numberInSurah": 2, "juz": 30, "page": 587, "textArabic": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "textSomali": "Xiddiguhuna daataan."}, {"number": 5832, "numberInSurah": 3, "juz": 30, "page": 587, "textArabic": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "textSomali": "Badahana laysku furo."}, {"number": 5833, "numberInSurah": 4, "juz": 30, "page": 587, "textArabic": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "textSomali": "Xabaalahana la soo bixiyo (Dadkii)."}, {"number": 5834, "numberInSurah": 5, "juz": 30, "page": 587, "textArabic": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "textSomali": "Waxay ogaan nafu waxay hor marsatay iyo waxay dibmarisay."}, {"number": 5835, "numberInSurah": 6, "juz": 30, "page": 587, "textArabic": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "textSomali": "Dadow maxaa kugu kadiyay Eebahaaga sharafta leh."}, {"number": 5836, "numberInSurah": 7, "juz": 30, "page": 587, "textArabic": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "textSomali": "Ee kii ku abuuray ah kuna ekeeyay kuna simay."}, {"number": 5837, "numberInSurah": 8, "juz": 30, "page": 587, "textArabic": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "textSomali": "Siduu doonana kuu sameeyey."}, {"number": 5838, "numberInSurah": 9, "juz": 30, "page": 587, "textArabic": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "textSomali": "Saas ma aha ee waxaad beeninaysaan abaal marinta."}, {"number": 5839, "numberInSurah": 10, "juz": 30, "page": 587, "textArabic": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "textSomali": "Malaa'ig baana idin ilaalinaysa."}, {"number": 5840, "numberInSurah": 11, "juz": 30, "page": 587, "textArabic": "كِرَامًۭا كَٰتِبِينَ", "textSomali": "Oo sharaf leh waxna qori."}, {"number": 5841, "numberInSurah": 12, "juz": 30, "page": 587, "textArabic": "يَعْلَمُونَ مَا تَفْعَلُونَ", "textSomali": "Ogna waxaad falaysaan."}, {"number": 5842, "numberInSurah": 13, "juz": 30, "page": 587, "textArabic": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "textSomali": "Kuwa wanaagsani waxay gali Naciima."}, {"number": 5843, "numberInSurah": 14, "juz": 30, "page": 587, "textArabic": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "textSomali": "Kuwa xun Xunna waxay gali Jaxiimo."}, {"number": 5844, "numberInSurah": 15, "juz": 30, "page": 587, "textArabic": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "textSomali": "Wayna ku guban Maalinta abaalmarinta."}, {"number": 5845, "numberInSurah": 16, "juz": 30, "page": 587, "textArabic": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "textSomali": "Kamana maqnaadaan Naarta."}, {"number": 5846, "numberInSurah": 17, "juz": 30, "page": 587, "textArabic": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "textSomali": "Maalinta abaalmarinta ma taqaannaa."}, {"number": 5847, "numberInSurah": 18, "juz": 30, "page": 587, "textArabic": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "textSomali": "Haddana ma taqaannaa Maalinta abaalmarinta."}, {"number": 5848, "numberInSurah": 19, "juz": 30, "page": 587, "textArabic": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "textSomali": "Waa Maalinta ayna u hanannin Nafna Naf kale waxba, Amarkana Maalintaas waxaa iska leh Eebe."}]}