{"number": 93, "nameArabic": "سُورَةُ الضُّحَىٰ", "nameEnglish": "Ad-Dhuhaa", "revelationType": "Meccan", "numberOfAyahs": 11, "bismillahPre": true, "ayahs": [{"number": 6080, "numberInSurah": 1, "juz": 30, "page": 596, "textArabic": "وَٱلضُّحَىٰ", "textSomali": "Eebe wuxuu ku dhaartay Barqinka."}, {"number": 6081, "numberInSurah": 2, "juz": 30, "page": 596, "textArabic": "وَٱلَّيْلِ إِذَا سَجَىٰ", "textSomali": "Iyo Habeenku markuu xasilo (Madoobaado)."}, {"number": 6082, "numberInSurah": 3, "juz": 30, "page": 596, "textArabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "textSomali": "Inaan Eebe ka tagin Nabiyow kuuna cadhoonin."}, {"number": 6083, "numberInSurah": 4, "juz": 30, "page": 596, "textArabic": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ", "textSomali": "Aakharana kaaga khayr badan Aduunka."}, {"number": 6084, "numberInSurah": 5, "juz": 30, "page": 596, "textArabic": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ", "textSomali": "Eebaana ku siindoona (wanaag) waadna raalli noqon."}, {"number": 6085, "numberInSurah": 6, "juz": 30, "page": 596, "textArabic": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ", "textSomali": "Miyuusan ku helin Eebahaa Adigoo Agoon ah oosan ku dhawaynin."}, {"number": 6086, "numberInSurah": 7, "juz": 30, "page": 596, "textArabic": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ", "textSomali": "Miyuunase ku helin Adigoo baadi ah oosan ku hanuuninin."}, {"number": 6087, "numberInSurah": 8, "juz": 30, "page": 596, "textArabic": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ", "textSomali": "Miyuunase ku helin Adigoo caydhi ah oosna ku hodminin (kuu waxyoonin)."}, {"number": 6088, "numberInSurah": 9, "juz": 30, "page": 596, "textArabic": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ", "textSomali": "Ee Agoonta ha xoogin (hana dhihin)."}, {"number": 6089, "numberInSurah": 10, "juz": 30, "page": 596, "textArabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ", "textSomali": "Ka wax su'aalina ha canaanan."}, {"number": 6090, "numberInSurah": 11, "juz": 30, "page": 596, "textArabic": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "textSomali": "Nicmada Eebahaana ka sheekee (ku mahadi)."}]}