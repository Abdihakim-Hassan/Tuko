{"number": 88, "nameArabic": "سُورَةُ الغَاشِيَةِ", "nameEnglish": "Al-Ghaashiya", "revelationType": "Meccan", "numberOfAyahs": 26, "bismillahPre": true, "ayahs": [{"number": 5968, "numberInSurah": 1, "juz": 30, "page": 592, "textArabic": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "textSomali": "Ma ku soo gadhay Qiyaamada warkeedii."}, {"number": 5969, "numberInSurah": 2, "juz": 30, "page": 592, "textArabic": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "textSomali": "Wajiyaal Maalintaas way dullaysnaan."}, {"number": 5970, "numberInSurah": 3, "juz": 30, "page": 592, "textArabic": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "textSomali": "Waxayna qaban Shaqo dhib ah."}, {"number": 5971, "numberInSurah": 4, "juz": 30, "page": 592, "textArabic": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "textSomali": "Waxayna gali Naar kulul."}, {"number": 5972, "numberInSurah": 5, "juz": 30, "page": 592, "textArabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "textSomali": "Waxaana laga waraabin il kulayl daran."}, {"number": 5973, "numberInSurah": 6, "juz": 30, "page": 592, "textArabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "textSomali": "Wax cunto ahna kama helaan oon ahayn cunno xun (oo wax dhibta)."}, {"number": 5974, "numberInSurah": 7, "juz": 30, "page": 592, "textArabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "textSomali": "Taasoon waxna cayilinhaynin Gaajana wax ka taraynin."}, {"number": 5975, "numberInSurah": 8, "juz": 30, "page": 592, "textArabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "textSomali": "Wajiyaalna maalintaas way Nicmaysnaan (Waa mu'miniinta)."}, {"number": 5976, "numberInSurah": 9, "juz": 30, "page": 592, "textArabic": "لِّسَعْيِهَا رَاضِيَةٌۭ", "textSomali": "Waxayna ka raalli noqotay camalkeedii."}, {"number": 5977, "numberInSurah": 10, "juz": 30, "page": 592, "textArabic": "فِى جَنَّةٍ عَالِيَةٍۢ", "textSomali": "Janno sarana way gali."}, {"number": 5978, "numberInSurah": 11, "juz": 30, "page": 592, "textArabic": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "textSomali": "Kumana maqasho Jannada hadal macna darro."}, {"number": 5979, "numberInSurah": 12, "juz": 30, "page": 592, "textArabic": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "textSomali": "Waxaana ah dhexdeed il socota."}, {"number": 5980, "numberInSurah": 13, "juz": 30, "page": 592, "textArabic": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "textSomali": "iyo Sariiro la koryeelay."}, {"number": 5981, "numberInSurah": 14, "juz": 30, "page": 592, "textArabic": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "textSomali": "Iyo koobab la hor dhigay (ehlu Jannaha)."}, {"number": 5982, "numberInSurah": 15, "juz": 30, "page": 592, "textArabic": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "textSomali": "Iyo Barkimooyin la safay."}, {"number": 5983, "numberInSurah": 16, "juz": 30, "page": 592, "textArabic": "وَزَرَابِىُّ مَبْثُوثَةٌ", "textSomali": "Iyo gogol la fidiyay."}, {"number": 5984, "numberInSurah": 17, "juz": 30, "page": 592, "textArabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "textSomali": "Miyayna fiirinaynin sida Deela loo abuuray."}, {"number": 5985, "numberInSurah": 18, "juz": 30, "page": 592, "textArabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "textSomali": "Iyo sida Samada loo koryeelay."}, {"number": 5986, "numberInSurah": 19, "juz": 30, "page": 592, "textArabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "textSomali": "Iyo sida Ruuraha loo taagay,"}, {"number": 5987, "numberInSurah": 20, "juz": 30, "page": 592, "textArabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "textSomali": "Iyo sida dhulka loo fidiyay."}, {"number": 5988, "numberInSurah": 21, "juz": 30, "page": 592, "textArabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "textSomali": "Ee Waani dadka waxaad tahay waaniyee (Nabiyow)."}, {"number": 5989, "numberInSurah": 22, "juz": 30, "page": 592, "textArabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "textSomali": "Mana tihid mid xoog ku leh (qasab)."}, {"number": 5990, "numberInSurah": 23, "juz": 30, "page": 592, "textArabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "textSomali": "Hase yeeshee Ruuxii xaqa ka jeedsada oo Gaalooba (ku soo celi xaqa)."}, {"number": 5991, "numberInSurah": 24, "juz": 30, "page": 592, "textArabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "textSomali": "Eebana wuu caddibi Caddibaadda u wayn."}, {"number": 5992, "numberInSurah": 25, "juz": 30, "page": 592, "textArabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "textSomali": "Xagganagayna u soo noqon (khalqigu)."}, {"number": 5993, "numberInSurah": 26, "juz": 30, "page": 592, "textArabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "textSomali": "Annagaana xisaabin."}]}