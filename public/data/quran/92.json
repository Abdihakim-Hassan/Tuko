{"number": 92, "nameArabic": "سُورَةُ اللَّيۡلِ", "nameEnglish": "Al-Lail", "revelationType": "Meccan", "numberOfAyahs": 21, "bismillahPre": true, "ayahs": [{"number": 6059, "numberInSurah": 1, "juz": 30, "page": 595, "textArabic": "وَٱلَّيْلِ إِذَا يَغْشَىٰ", "textSomali": "Eebe wuxuu ku dhaartay Habeenku markuu wax qariyo."}, {"number": 6060, "numberInSurah": 2, "juz": 30, "page": 595, "textArabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "textSomali": "Iyo markay Maalintu Muuqato (ifto)."}, {"number": 6061, "numberInSurah": 3, "juz": 30, "page": 595, "textArabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "textSomali": "Iyo Abuuridda Dadka Lab iyo dhaddigba."}, {"number": 6062, "numberInSurah": 4, "juz": 30, "page": 595, "textArabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "textSomali": "In Camalkiinnu (dadow) kala duwanyahay."}, {"number": 6063, "numberInSurah": 5, "juz": 30, "page": 595, "textArabic": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "textSomali": "Ruuxiise bixiya (xuquuqda) Eebana ka dhawrsada."}, {"number": 6064, "numberInSurah": 6, "juz": 30, "page": 595, "textArabic": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "textSomali": "Rumeeyana tii wanaaga badnayd (ciwal)."}, {"number": 6065, "numberInSurah": 7, "juz": 30, "page": 595, "textArabic": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "textSomali": "Waxaanni u fududaynaa wanaagga (iyo Jidka fiican)."}, {"number": 6066, "numberInSurah": 8, "juz": 30, "page": 595, "textArabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "textSomali": "Ruuxiise ku bakhayla Xoolaha isna deeqtoonaysiiya «iskibriya»."}, {"number": 6067, "numberInSurah": 9, "juz": 30, "page": 595, "textArabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "textSomali": "Reeniyana Tii wanaaga badnayd (ciwal)."}, {"number": 6068, "numberInSurah": 10, "juz": 30, "page": 595, "textArabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "textSomali": "Waxaan u fududaynaa Jidka xun."}, {"number": 6069, "numberInSurah": 11, "juz": 30, "page": 595, "textArabic": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "textSomali": "Xoolihiisuna wax uma taraan markuu halaagsamo."}, {"number": 6070, "numberInSurah": 12, "juz": 30, "page": 595, "textArabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "textSomali": "Annagaa wax hanuuninna."}, {"number": 6071, "numberInSurah": 13, "juz": 30, "page": 595, "textArabic": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "textSomali": "Aakhariyo Addunbana Annagaa iska leh."}, {"number": 6072, "numberInSurah": 14, "juz": 30, "page": 595, "textArabic": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "textSomali": "Waxana idiinka digaynaa Naar kulayl daran."}, {"number": 6073, "numberInSurah": 15, "juz": 30, "page": 596, "textArabic": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "textSomali": "Oosan galaynin Ruux xun mooyeen."}, {"number": 6074, "numberInSurah": 16, "juz": 30, "page": 596, "textArabic": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "textSomali": "Oo xaqa beeniyay jeedsadayna."}, {"number": 6075, "numberInSurah": 17, "juz": 30, "page": 596, "textArabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "textSomali": "Waxaana ka fogaada (galidda naarta) Ruuxii Eeba ka dhawrsada."}, {"number": 6076, "numberInSurah": 18, "juz": 30, "page": 596, "textArabic": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "textSomali": "Ee bixiya Xoolihiisa si uu u daahirnoqdo."}, {"number": 6077, "numberInSurah": 19, "juz": 30, "page": 596, "textArabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "textSomali": "Ruux wax ugu nicmeeyayna oo abaalmarinna ma uusanjirin."}, {"number": 6078, "numberInSurah": 20, "juz": 30, "page": 596, "textArabic": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "textSomali": "Ee Wuxuu u bixin dar Eebaha sareeya."}, {"number": 6079, "numberInSurah": 21, "juz": 30, "page": 596, "textArabic": "وَلَسَوْفَ يَرْضَىٰ", "textSomali": "Wuuna raalli noqondoonaa Ruuxaasi."}]}