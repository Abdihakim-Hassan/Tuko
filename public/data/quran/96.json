{"number": 96, "nameArabic": "سُورَةُ العَلَقِ", "nameEnglish": "Al-Alaq", "revelationType": "Meccan", "numberOfAyahs": 19, "bismillahPre": true, "ayahs": [{"number": 6107, "numberInSurah": 1, "juz": 30, "page": 597, "textArabic": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "textSomali": "Wax ku akhri Nabiyow Magaca Eebe ee abuuray (khaliqiga)."}, {"number": 6108, "numberInSurah": 2, "juz": 30, "page": 597, "textArabic": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "textSomali": "Dadkana ka abuuray Calaq."}, {"number": 6109, "numberInSurah": 3, "juz": 30, "page": 597, "textArabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "textSomali": "Akhri Eebana waa kan Sharafta lehe."}, {"number": 6110, "numberInSurah": 4, "juz": 30, "page": 597, "textArabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "textSomali": "Ee Dadka baray sida Qalinka wax loogu qoro."}, {"number": 6111, "numberInSurah": 5, "juz": 30, "page": 597, "textArabic": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "textSomali": "Dadkana baray waxayna aqoonin."}, {"number": 6112, "numberInSurah": 6, "juz": 30, "page": 597, "textArabic": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "textSomali": "Saas ma aha ee Dadku (Gaaladu) waa gudbeen."}, {"number": 6113, "numberInSurah": 7, "juz": 30, "page": 597, "textArabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "textSomali": "Markuu isku ogaaday Hodontinnimo."}, {"number": 6114, "numberInSurah": 8, "juz": 30, "page": 597, "textArabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "textSomali": "Eebaha xaggiisaase loo noqon."}, {"number": 6115, "numberInSurah": 9, "juz": 30, "page": 597, "textArabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "textSomali": "Ka warrama midka ka reebaya."}, {"number": 6116, "numberInSurah": 10, "juz": 30, "page": 597, "textArabic": "عَبْدًا إِذَا صَلَّىٰٓ", "textSomali": "Addoon (Eebe) oo tukan Salaadda."}, {"number": 6117, "numberInSurah": 11, "juz": 30, "page": 597, "textArabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "textSomali": "Bal ka warrama hadduu ka laga reebi hanuunsanyahay (waa Nabiga)."}, {"number": 6118, "numberInSurah": 12, "juz": 30, "page": 597, "textArabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "textSomali": "Ama uu fari Eeba ka yaabid."}, {"number": 6119, "numberInSurah": 13, "juz": 30, "page": 597, "textArabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "textSomali": "Balse ka warrama hadduu midka wax ka reebi uu beeniyay (xaqa) kana jeedsaday (waa AbuuJahal iyo wixii la mid ahe)."}, {"number": 6120, "numberInSurah": 14, "juz": 30, "page": 597, "textArabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "textSomali": "Miyuusan ogayn in Eebe arko."}, {"number": 6121, "numberInSurah": 15, "juz": 30, "page": 597, "textArabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "textSomali": "Saas ma aha ee hadduusan joogin waxaannu qaban Foodda."}, {"number": 6122, "numberInSurah": 16, "juz": 30, "page": 597, "textArabic": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "textSomali": "Food beenaleey ah ghafna badan."}, {"number": 6123, "numberInSurah": 17, "juz": 30, "page": 597, "textArabic": "فَلْيَدْعُ نَادِيَهُۥ", "textSomali": "Ha u yeedho gargaarihiisa."}, {"number": 6124, "numberInSurah": 18, "juz": 30, "page": 597, "textArabic": "سَنَدْعُ ٱلزَّبَانِيَةَ", "textSomali": "Waxaanu u yeedhi Malaa'ig darane."}, {"number": 6125, "numberInSurah": 19, "juz": 30, "page": 597, "textArabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "textSomali": "Saas ma aha ee warkiisa ha maqlin Sujuudna una dhawow (Eebe)."}]}