{"number": 91, "nameArabic": "سُورَةُ الشَّمۡسِ", "nameEnglish": "Ash-Shams", "revelationType": "Meccan", "numberOfAyahs": 15, "bismillahPre": true, "ayahs": [{"number": 6044, "numberInSurah": 1, "juz": 30, "page": 595, "textArabic": "وَٱلشَّمْسِ وَضُحَىٰهَا", "textSomali": "Eebe wuxuu ku dhaartay Qorraxda iyo Barqinkeeda."}, {"number": 6045, "numberInSurah": 2, "juz": 30, "page": 595, "textArabic": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "textSomali": "Iyo Dayuxu markuu Qorraxda raaco."}, {"number": 6046, "numberInSurah": 3, "juz": 30, "page": 595, "textArabic": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "textSomali": "Iyo Maalintu markay ifiso."}, {"number": 6047, "numberInSurah": 4, "juz": 30, "page": 595, "textArabic": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "textSomali": "Iyo Habeenku markuu daboolo (madoobaado)."}, {"number": 6048, "numberInSurah": 5, "juz": 30, "page": 595, "textArabic": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "textSomali": "Iyo Samada iyo say u dhisantahay."}, {"number": 6049, "numberInSurah": 6, "juz": 30, "page": 595, "textArabic": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "textSomali": "Iyo Dhulka iyo suu u fidsanyahay."}, {"number": 6050, "numberInSurah": 7, "juz": 30, "page": 595, "textArabic": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "textSomali": "Iyo Nafta iyo sida Eebe u ekeeyay."}, {"number": 6051, "numberInSurah": 8, "juz": 30, "page": 595, "textArabic": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "textSomali": "Una tusiyay Jidka xun iyo ka Eebe kayaabiddaba."}, {"number": 6052, "numberInSurah": 9, "juz": 30, "page": 595, "textArabic": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "textSomali": "Ee waxaa liibaanay Ruxii Naftiisa Daarhiriya."}, {"number": 6053, "numberInSurah": 10, "juz": 30, "page": 595, "textArabic": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "textSomali": "Waxaana khasaaray Ruuxii Naftiisa xumaan dhex galiya."}, {"number": 6054, "numberInSurah": 11, "juz": 30, "page": 595, "textArabic": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "textSomali": "Thamuud waxay beeniyeen (xaqii) kibir dartiis."}, {"number": 6055, "numberInSurah": 12, "juz": 30, "page": 595, "textArabic": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "textSomali": "Marku tagay koodi xumaa (si uu hasha u dilo)."}, {"number": 6056, "numberInSurah": 13, "juz": 30, "page": 595, "textArabic": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "textSomali": "Oo Rasuulkii Eebana ku yidhi, iska daaya Hasha Eebe iyo Cabbideeda."}, {"number": 6057, "numberInSurah": 14, "juz": 30, "page": 595, "textArabic": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "textSomali": "Wayna beeniyeen Rasuulkii Hashiina way Dileen markaasaa Eebe si daran u caddibay Dambigooda dartiis."}, {"number": 6058, "numberInSurah": 15, "juz": 30, "page": 595, "textArabic": "وَلَا يَخَافُ عُقْبَٰهَا", "textSomali": "Isagoon Eebe ka yaabaynin cidhib (iyo wax yeello)"}]}