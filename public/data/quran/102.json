{"number": 102, "nameArabic": "سُورَةُ التَّكَاثُرِ", "nameEnglish": "At-Takaathur", "revelationType": "Meccan", "numberOfAyahs": 8, "bismillahPre": true, "ayahs": [{"number": 6169, "numberInSurah": 1, "juz": 30, "page": 600, "textArabic": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "textSomali": "Waxaa idin shuqliyay Dadow wax badsasho (iyo isu faanid),"}, {"number": 6170, "numberInSurah": 2, "juz": 30, "page": 600, "textArabic": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "textSomali": "Intaad Xabaalaha ka tagtaan (dhimataan)."}, {"number": 6171, "numberInSurah": 3, "juz": 30, "page": 600, "textArabic": "كَلَّا سَوْفَ تَعْلَمُونَ", "textSomali": "Saas ma aha ee waad ogaandoontaan."}, {"number": 6172, "numberInSurah": 4, "juz": 30, "page": 600, "textArabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "textSomali": "Haddana saas ma ehee waad ogaandoontaan (Faanka cidhibtiisa)."}, {"number": 6173, "numberInSurah": 5, "juz": 30, "page": 600, "textArabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "textSomali": "Haddaad dhab ahaan wax u ogtihiin (Waad dayn lahaydeen xumaanta)."}, {"number": 6174, "numberInSurah": 6, "juz": 30, "page": 600, "textArabic": "لَتَرَوُنَّ ٱلْجَحِيمَ", "textSomali": "Dhab ahaan baad u arkaysaan (Naarta) Jaxiima,"}, {"number": 6175, "numberInSurah": 7, "juz": 30, "page": 600, "textArabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "textSomali": "Ka dibna waxaad u arkaysaan Nartaas si yaqiin ah."}, {"number": 6176, "numberInSurah": 8, "juz": 30, "page": 600, "textArabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "textSomali": "Waxaana laydin warsan Maalintaas Nicmadii."}]}