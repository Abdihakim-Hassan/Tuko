{"number": 107, "nameArabic": "سُورَةُ المَاعُونِ", "nameEnglish": "Al-Maa'un", "revelationType": "Meccan", "numberOfAyahs": 7, "bismillahPre": true, "ayahs": [{"number": 6198, "numberInSurah": 1, "juz": 30, "page": 602, "textArabic": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "textSomali": "Ka warrama kan beenin Abaalmarinta (Qiyaamada)."}, {"number": 6199, "numberInSurah": 2, "juz": 30, "page": 602, "textArabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "textSomali": "Kaas xooga Agoonta (xageeda)."}, {"number": 6200, "numberInSurah": 3, "juz": 30, "page": 602, "textArabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "textSomali": "Aan kuna boorrinaynin quudinta miskiinka."}, {"number": 6201, "numberInSurah": 4, "juz": 30, "page": 602, "textArabic": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "textSomali": "Waxaa halaag u sugnaaday kuwa tukan (waa Munaafiqiinta)."}, {"number": 6202, "numberInSurah": 5, "juz": 30, "page": 602, "textArabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "textSomali": "Ee haddana halmaansan Salaaddooda."}, {"number": 6203, "numberInSurah": 6, "juz": 30, "page": 602, "textArabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "textSomali": "Dadkana is tusiya."}, {"number": 6204, "numberInSurah": 7, "juz": 30, "page": 602, "textArabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "textSomali": "Una diida alaabta (Laysugu kaalmeeyo)."}]}