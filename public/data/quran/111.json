{"number": 111, "nameArabic": "سُورَةُ المَسَدِ", "nameEnglish": "Al-Masad", "revelationType": "Meccan", "numberOfAyahs": 5, "bismillahPre": true, "ayahs": [{"number": 6217, "numberInSurah": 1, "juz": 30, "page": 603, "textArabic": "تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ", "textSomali": "Waxaa khasaaray Gacmihii Abuulahab, halaagmayna."}, {"number": 6218, "numberInSurah": 2, "juz": 30, "page": 603, "textArabic": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ", "textSomali": "Waxna uma tarin Xoolihiisii iyo wuxuu kasbadayna."}, {"number": 6219, "numberInSurah": 3, "juz": 30, "page": 603, "textArabic": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ", "textSomali": "Wuxuuna gali Naar Olal leh."}, {"number": 6220, "numberInSurah": 4, "juz": 30, "page": 603, "textArabic": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ", "textSomali": "Haweenaydiisii Qoryaha xambaari jirtayna (waxay gali Naar)."}, {"number": 6221, "numberInSurah": 5, "juz": 30, "page": 603, "textArabic": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ", "textSomali": "Luqunteedana waxaa la yeeli Xadhig Liif ah."}]}