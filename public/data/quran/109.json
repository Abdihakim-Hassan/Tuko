{"number": 109, "nameArabic": "سُورَةُ الكَافِرُونَ", "nameEnglish": "Al-Kaafiroon", "revelationType": "Meccan", "numberOfAyahs": 6, "bismillahPre": true, "ayahs": [{"number": 6208, "numberInSurah": 1, "juz": 30, "page": 603, "textArabic": "قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ", "textSomali": "Waxaad dhahdaa, Gaalooy."}, {"number": 6209, "numberInSurah": 2, "juz": 30, "page": 603, "textArabic": "لَآ أَعْبُدُ مَا تَعْبُدُونَ", "textSomali": "Ma caabudayo waxaad caabudaysaan."}, {"number": 6210, "numberInSurah": 3, "juz": 30, "page": 603, "textArabic": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "textSomali": "Idinna ma caabudaysaan Eebahaan caabudi."}, {"number": 6211, "numberInSurah": 4, "juz": 30, "page": 603, "textArabic": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ", "textSomali": "Mana caabudin waxaad caabuddeen,"}, {"number": 6212, "numberInSurah": 5, "juz": 30, "page": 603, "textArabic": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "textSomali": "Idinkuna (hadda) ma caabudaysaan Eebahaan caabudi."}, {"number": 6213, "numberInSurah": 6, "juz": 30, "page": 603, "textArabic": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ", "textSomali": "Idinkana Diintiina yaad leedihiin, Anna Diintaydaan leeyahay."}]}