{"number": 81, "nameArabic": "سُورَةُ التَّكۡوِيرِ", "nameEnglish": "At-Takwir", "revelationType": "Meccan", "numberOfAyahs": 29, "bismillahPre": true, "ayahs": [{"number": 5801, "numberInSurah": 1, "juz": 30, "page": 586, "textArabic": "إِذَا ٱلشَّمْسُ كُوِّرَتْ", "textSomali": "Marka qorraxda la duubo (Qiyaamada)."}, {"number": 5802, "numberInSurah": 2, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "textSomali": "Xiddiguhuna daataan (iyagoo Madow)."}, {"number": 5803, "numberInSurah": 3, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "textSomali": "Buurahana la kexeeyo (La rujiyo)."}, {"number": 5804, "numberInSurah": 4, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "textSomali": "Geelii rimmanaana la halleeyo."}, {"number": 5805, "numberInSurah": 5, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "textSomali": "Dugaaggana la kulmiyo (Qisaas darteed)."}, {"number": 5806, "numberInSurah": 6, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "textSomali": "Badahana la kululeeyo."}, {"number": 5807, "numberInSurah": 7, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "textSomali": "Naf walbana Jidhkeedii lammaaneeyo."}, {"number": 5808, "numberInSurah": 8, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "textSomali": "Gabdhihii la xabaalnololiyayna la warsado."}, {"number": 5809, "numberInSurah": 9, "juz": 30, "page": 586, "textArabic": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "textSomali": "Maxaa dambi ah oo loo dilay."}, {"number": 5810, "numberInSurah": 10, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "textSomali": "Kutubta (camalkana) la fidiyo."}, {"number": 5811, "numberInSurah": 11, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "textSomali": "Samadana la rujiyo."}, {"number": 5812, "numberInSurah": 12, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "textSomali": "Naarta Jaxiimana la huriyo."}, {"number": 5813, "numberInSurah": 13, "juz": 30, "page": 586, "textArabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "textSomali": "Jannadana la dhaweeyo."}, {"number": 5814, "numberInSurah": 14, "juz": 30, "page": 586, "textArabic": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "textSomali": "Waxay ogaan nafu waxay camal fashay."}, {"number": 5815, "numberInSurah": 15, "juz": 30, "page": 586, "textArabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "textSomali": "Waxaan ku dhaartay «huu Eebe yidhi» Xiddigaha Qarsooma (Maalintii)."}, {"number": 5816, "numberInSurah": 16, "juz": 30, "page": 586, "textArabic": "ٱلْجَوَارِ ٱلْكُنَّسِ", "textSomali": "Ee socda iftiinka Qorraxdana ku qarsooma."}, {"number": 5817, "numberInSurah": 17, "juz": 30, "page": 586, "textArabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "textSomali": "Iyo Habecnku markuu jeedsado."}, {"number": 5818, "numberInSurah": 18, "juz": 30, "page": 586, "textArabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "textSomali": "Iyo subaxu markuu soo qaabilo."}, {"number": 5819, "numberInSurah": 19, "juz": 30, "page": 586, "textArabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "textSomali": "Ee Quraanku waa hadalka Eebe, Soona raray Malag sharaf lah."}, {"number": 5820, "numberInSurah": 20, "juz": 30, "page": 586, "textArabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "textSomali": "Xoogna leh Eeba agtiisana Daraja ku leh."}, {"number": 5821, "numberInSurah": 21, "juz": 30, "page": 586, "textArabic": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "textSomali": "Laguna addeeco halkaas aaminna ah."}, {"number": 5822, "numberInSurah": 22, "juz": 30, "page": 586, "textArabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "textSomali": "Saaxiibkiinna (Nabiguna) ma aha ku waalan."}, {"number": 5823, "numberInSurah": 23, "juz": 30, "page": 586, "textArabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "textSomali": "Horaybuuna ugn arkay Jibriil Jahadii Caddayd (Bariga Maka)."}, {"number": 5824, "numberInSurah": 24, "juz": 30, "page": 586, "textArabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "textSomali": "Nabiguna ma aha Ruux lugu shakiyo waxa Maqan."}, {"number": 5825, "numberInSurah": 25, "juz": 30, "page": 586, "textArabic": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "textSomali": "Qaraankuna ma aha hadal shaydaan la fogeeyay."}, {"number": 5826, "numberInSurah": 26, "juz": 30, "page": 586, "textArabic": "فَأَيْنَ تَذْهَبُونَ", "textSomali": "Ee xaggeed Gaalooy aadaysaan."}, {"number": 5827, "numberInSurah": 27, "juz": 30, "page": 586, "textArabic": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "textSomali": "Quraankuna waxaan waanada caalamka ahayn ina aha (waa waano)."}, {"number": 5828, "numberInSurah": 28, "juz": 30, "page": 586, "textArabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "textSomali": "Ruuxii doona inuu toosnaado (yuuna u yahay)."}, {"number": 5829, "numberInSurah": 29, "juz": 30, "page": 586, "textArabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "textSomali": "Waxna ma dooni kartaan in Eebaha Caalamku doona mooyec."}]}