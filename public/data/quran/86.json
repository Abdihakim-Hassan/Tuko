{"number": 86, "nameArabic": "سُورَةُ الطَّارِقِ", "nameEnglish": "At-Taariq", "revelationType": "Meccan", "numberOfAyahs": 17, "bismillahPre": true, "ayahs": [{"number": 5932, "numberInSurah": 1, "juz": 30, "page": 591, "textArabic": "وَٱلسَّمَآءِ وَٱلطَّارِقِ", "textSomali": "Eebe wuxuu ku dhaartay Samada iyo Xiddigga guura."}, {"number": 5933, "numberInSurah": 2, "juz": 30, "page": 591, "textArabic": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "textSomali": "Ma taqaan Xiddigga guura."}, {"number": 5934, "numberInSurah": 3, "juz": 30, "page": 591, "textArabic": "ٱلنَّجْمُ ٱلثَّاقِبُ", "textSomali": "Waa Xiddig ifa."}, {"number": 5935, "numberInSurah": 4, "juz": 30, "page": 591, "textArabic": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "textSomali": "Ee Nafwalba waxaa kor jooga ilaaliye (Malag)."}, {"number": 5936, "numberInSurah": 5, "juz": 30, "page": 591, "textArabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "textSomali": "Ee Dadku ha dayo waxa laga abuuray."}, {"number": 5937, "numberInSurah": 6, "juz": 30, "page": 591, "textArabic": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "textSomali": "Waxaa laga abuuray Biyo booda."}, {"number": 5938, "numberInSurah": 7, "juz": 30, "page": 591, "textArabic": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "textSomali": "Kana soobaxa Dhabar iyo laab dhexdood."}, {"number": 5939, "numberInSurah": 8, "juz": 30, "page": 591, "textArabic": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "textSomali": "Eebana waa karaa soo celinta Dadka (qiyaamada)."}, {"number": 5940, "numberInSurah": 9, "juz": 30, "page": 591, "textArabic": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "textSomali": "Maalinta la imtixaani waxa (Laabta) ku qarsoon."}, {"number": 5941, "numberInSurah": 10, "juz": 30, "page": 591, "textArabic": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "textSomali": "Dadkuna Xoog ma leh (Maalintaas) iyo wax u gargaaara midna."}, {"number": 5942, "numberInSurah": 11, "juz": 30, "page": 591, "textArabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "textSomali": "Eebana wuxuu ku dhaartay Samada Roobka leh."}, {"number": 5943, "numberInSurah": 12, "juz": 30, "page": 591, "textArabic": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "textSomali": "Iyo Dhulka jeexma (waxna ka soo baxo)."}, {"number": 5944, "numberInSurah": 13, "juz": 30, "page": 591, "textArabic": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "textSomali": "Ee Quraanku waa hadal wax kala bixiya (wanaagga iyo Xumaanta)."}, {"number": 5945, "numberInSurah": 14, "juz": 30, "page": 591, "textArabic": "وَمَا هُوَ بِٱلْهَزْلِ", "textSomali": "Ciyaarra ma aha (ee waa dhab)."}, {"number": 5946, "numberInSurah": 15, "juz": 30, "page": 591, "textArabic": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "textSomali": "Gaaladu waxbay dhakri."}, {"number": 5947, "numberInSurah": 16, "juz": 30, "page": 591, "textArabic": "وَأَكِيدُ كَيْدًۭا", "textSomali": "Annaguna waanu kaydi (Abaalmarin)."}, {"number": 5948, "numberInSurah": 17, "juz": 30, "page": 591, "textArabic": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "textSomali": "Ee u sug Gaalada wax yar."}]}