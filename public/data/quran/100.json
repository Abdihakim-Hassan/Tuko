{"number": 100, "nameArabic": "سُورَةُ العَادِيَاتِ", "nameEnglish": "Al-Aadiyaat", "revelationType": "Meccan", "numberOfAyahs": 11, "bismillahPre": true, "ayahs": [{"number": 6147, "numberInSurah": 1, "juz": 30, "page": 599, "textArabic": "وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "textSomali": "Eebe wuxuu ku dhaartay Fardaha Jahaadka u orda iyagoo qaylyi."}, {"number": 6148, "numberInSurah": 2, "juz": 30, "page": 599, "textArabic": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "textSomali": "iyo kuwa dabka Qoobkooda ku ifiya (guuraha)."}, {"number": 6149, "numberInSurah": 3, "juz": 30, "page": 599, "textArabic": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "textSomali": "Iyo kuwa Cadawga weerara Subaxdii."}, {"number": 6150, "numberInSurah": 4, "juz": 30, "page": 599, "textArabic": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "textSomali": "Ee Boodhka kiciya."}, {"number": 6151, "numberInSurah": 5, "juz": 30, "page": 599, "textArabic": "فَوَسَطْنَ بِهِۦ جَمْعًا", "textSomali": "Cadawgana dhexgala."}, {"number": 6152, "numberInSurah": 6, "juz": 30, "page": 599, "textArabic": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "textSomali": "Ee Dadku Eebohood waa diideen."}, {"number": 6153, "numberInSurah": 7, "juz": 30, "page": 599, "textArabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "textSomali": "Arrintaasna Dadku wuu ogyahay."}, {"number": 6154, "numberInSurah": 8, "juz": 30, "page": 599, "textArabic": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "textSomali": "Dadkuna Xoola jacaylka waa ku daranyahay."}, {"number": 6155, "numberInSurah": 9, "juz": 30, "page": 599, "textArabic": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "textSomali": "Miyuuna ogayn Marka Xabaalaha waxa ku jira la soo bixiyo."}, {"number": 6156, "numberInSurah": 10, "juz": 30, "page": 600, "textArabic": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "textSomali": "Laabaha waxa ku qarsoonna la muujiyo."}, {"number": 6157, "numberInSurah": 11, "juz": 30, "page": 600, "textArabic": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "textSomali": "In Eebohood Maalintaas ogyahay."}]}